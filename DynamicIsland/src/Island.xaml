                  <Ellipse x:Name="pm1" Width="10" Height="10" Fill="#33FFFFFF" Margin="0,0,7,0"/>
                  <Ellipse x:Name="pm2" Width="10" Height="10" Fill="#33FFFFFF" Margin="0,0,7,0"/>
                  <Ellipse x:Name="pm3" Width="10" Height="10" Fill="#33FFFFFF" Margin="0,0,7,0"/>
                  <Ellipse x:Name="pm4" Width="10" Height="10" Fill="#33FFFFFF"/>
                </StackPanel>
                <TextBlock x:Name="pomoInfo" Text="25 мин работы, 5 мин отдыха. После четырёх кругов — длинный перерыв 15 мин." Style="{StaticResource CardTxt}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Button x:Name="btnPomo" Style="{StaticResource PillBtn}" Content="Начать фокус" Background="#F2F2F2" Foreground="#101014" HorizontalAlignment="Left" Margin="0" Padding="16,7"/>
              </StackPanel>
            </Border>
            <Button x:Name="btnQuit" Grid.Row="2" Style="{StaticResource PillBtn}" Content="Выключить островок" Background="#4DFF453A" Foreground="#FFB4AB" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,8"/>
          </Grid>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border CornerRadius="22" Background="#14FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" Padding="18,12,18,12" Margin="0,0,0,12">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="НАСТРОЙКИ" Style="{StaticResource SecLabel}"/>
                <Grid Margin="0,0,0,9"><TextBlock Text="Автозапуск с Windows" Style="{StaticResource RowTxt}"/><ToggleButton x:Name="swAuto" Style="{StaticResource Switch}" HorizontalAlignment="Right"/></Grid>
                <Grid Margin="0,0,0,9"><TextBlock Text="Эквалайзер в пилюле" Style="{StaticResource RowTxt}"/><ToggleButton x:Name="swEq" Style="{StaticResource Switch}" HorizontalAlignment="Right"/></Grid>
                <Grid Margin="0,0,0,9"><TextBlock Text="Показывать зарядку" Style="{StaticResource RowTxt}"/><ToggleButton x:Name="swCharge" Style="{StaticResource Switch}" HorizontalAlignment="Right"/></Grid>
                <Grid Margin="0,0,0,9"><TextBlock Text="Прятаться в полноэкранном режиме" Style="{StaticResource RowTxt}"/><ToggleButton x:Name="swFull" Style="{StaticResource Switch}" HorizontalAlignment="Right"/></Grid>
                <Grid Margin="0,0,0,0"><TextBlock Text="Часы при наведении" Style="{StaticResource RowTxt}"/><ToggleButton x:Name="swClock" Style="{StaticResource Switch}" HorizontalAlignment="Right"/></Grid>
                <TextBlock Text="ГОРЯЧАЯ КЛАВИША" Style="{StaticResource SecLabel}" Margin="0,14,0,8"/>
                <WrapPanel x:Name="hkHost"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="1" CornerRadius="22" Background="#14FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" Padding="18,12,18,12">
              <StackPanel>
                <TextBlock Text="КАЛЕНДАРЬ ПО ССЫЛКЕ (ICS)" Style="{StaticResource SecLabel}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid >
                <TextBox x:Name="icsIn" Style="{StaticResource GlassBox}" MaxLength="160"/>
                <TextBlock x:Name="icsInHint" Text="Ссылка на .ics (Google, Outlook…)" Style="{StaticResource CardTxt}" FontSize="13" IsHitTestVisible="False" Margin="13,0,0,0" VerticalAlignment="Center"/>
              </Grid>
                  <Button x:Name="btnIcsSave" Grid.Column="1" Style="{StaticResource PillBtn}" Content="Сохранить" Margin="8,0,0,0" Padding="12,8"/>
                </Grid>
                <TextBlock x:Name="icsInfo" Text="Необязательно: события подтянутся в «Дела»" Style="{StaticResource CardTxt}" FontSize="10.5" Margin="3,6,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
          </Grid>

        </Grid>

        <Grid x:Name="mTimerRun" Visibility="Hidden" Margin="26,62,26,22" RenderTransformOrigin="0.5,0">
          <Grid.RenderTransform><TranslateTransform Y="0"/></Grid.RenderTransform>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="xTimerPhase" Text="" Foreground="#FF9F0A" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
            <TextBlock x:Name="xTimerBig" Text="5:00" Foreground="White" FontSize="72" FontWeight="Light" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
              <Button x:Name="btnPause" Style="{StaticResource PillBtn}" Content="Пауза" Padding="18,8"/>
              <Button x:Name="btnStop" Style="{StaticResource PillBtn}" Content="Стоп" Background="#4DFF453A" Foreground="#FFB4AB" Margin="0" Padding="18,8"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- add-site dialog: dims the WHOLE panel (the island's rounded clip shapes it, so there is no square box) -->
        <Grid x:Name="siteAdd" Visibility="Collapsed" Opacity="0">
          <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
              <GradientStop Color="#78060608" Offset="0"/>
              <GradientStop Color="#B4060608" Offset="1"/>
            </RadialGradientBrush>
          </Grid.Background>
          <Border x:Name="siteCard" Width="400" CornerRadius="22" Background="#F2161619" BorderBrush="#2AFFFFFF" BorderThickness="1" Padding="20,16,20,18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><TransformGroup><ScaleTransform ScaleX="0.94" ScaleY="0.94"/><TranslateTransform X="0"/></TransformGroup></Border.RenderTransform>
            <StackPanel>
              <TextBlock Text="Новый сайт" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <Grid Margin="0,0,0,8">
                <TextBox x:Name="siteUrl" Style="{StaticResource GlassBox}"/>
                <TextBlock x:Name="siteUrlHint" Text="Адрес, например youtube.com" Style="{StaticResource CardTxt}" FontSize="13" IsHitTestVisible="False" Margin="13,0,0,0" VerticalAlignment="Center"/>
              </Grid>
              <Grid Margin="0,0,0,10">
                <TextBox x:Name="siteName" Style="{StaticResource GlassBox}"/>
                <TextBlock x:Name="siteNameHint" Text="Название (необязательно)" Style="{StaticResource CardTxt}" FontSize="13" IsHitTestVisible="False" Margin="13,0,0,0" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="siteErr" Text="" Foreground="#FF7A70" FontSize="11" Margin="2,0,0,8" Visibility="Collapsed"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="btnSiteOk" Style="{StaticResource PillBtn}" Content="Добавить" Background="#F2F2F2" Foreground="#101014"/>
                <Button x:Name="btnSitePaste" Style="{StaticResource PillBtn}" Content="Из буфера"/>
                <Button x:Name="btnSiteCancel" Style="{StaticResource PillBtn}" Content="Отмена" Margin="0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Button x:Name="btnX" Style="{StaticResource IcoBtn}" Background="#26FFFFFF" Width="26" Height="26" Margin="0,16,16,0" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Path Data="M0 0 L8 8 M8 0 L0 8" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Stretch="Uniform"/>
        </Button>
      </Grid>

      <!-- ================= GLASS FINISH (above content) ================= -->
      <Border x:Name="Spec" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#34FFFFFF" Offset="0"/>
            <GradientStop Color="#0CFFFFFF" Offset="0.32"/>
            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
            <GradientStop Color="#10FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Canvas x:Name="sweepLight" IsHitTestVisible="False" Opacity="0">
        <Rectangle Width="130" Height="720" Canvas.Top="-100">
          <Rectangle.RenderTransform>
            <TransformGroup>
              <RotateTransform Angle="16"/>
              <TranslateTransform x:Name="sweepX" X="-260"/>
            </TransformGroup>
          </Rectangle.RenderTransform>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00FFFFFF" Offset="0"/>
              <GradientStop Color="#58FFFFFF" Offset="0.5"/>
              <GradientStop Color="#00FFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Canvas>

      <!-- inner lip + rim light -->
      <Border x:Name="RimGlow" IsHitTestVisible="False" BorderThickness="3" CornerRadius="17" Margin="0">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2EFFFFFF" Offset="0"/>
            <GradientStop Color="#08FFFFFF" Offset="0.45"/>
            <GradientStop Color="#18FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect><BlurEffect Radius="3.5" KernelType="Gaussian"/></Border.Effect>
      </Border>
      <Border x:Name="Rim" IsHitTestVisible="False" BorderThickness="1.1" CornerRadius="17">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B8FFFFFF" Offset="0"/>
            <GradientStop Color="#34FFFFFF" Offset="0.28"/>
            <GradientStop Color="#0EFFFFFF" Offset="0.55"/>
            <GradientStop Color="#2CFFFFFF" Offset="0.82"/>
            <GradientStop Color="#78FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>
    </Grid>
  </Canvas>
</Window>
