<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island" Width="780" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Focusable="False" UseLayoutRounding="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>

    <!-- ===== buttons ===== -->
    <Style x:Key="IcoBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="hov" CornerRadius="12" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.16"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.045" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.045" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.26" Duration="0:0:0.07"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.2"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.045" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.045" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RoundBtn" TargetType="Button">
      <Setter Property="Background" Value="#18FFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="99" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border x:Name="hov" CornerRadius="99" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.13" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.07"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.13" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="99"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border x:Name="hov" CornerRadius="99" Background="#000000" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.07"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TransportBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Ellipse x:Name="hov" Fill="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
              <Ellipse x:Name="bgc" Fill="{TemplateBinding Background}" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.15"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.25"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.24" Duration="0:0:0.06"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.86" Duration="0:0:0.07"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.86" Duration="0:0:0.07"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.2"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TabBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#99FFFFFF"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Border x:Name="hov" CornerRadius="14" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14" Padding="9,7">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.16"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- generic row / tile button: any content, soft hover, press squeeze -->
    <Style x:Key="RowBtn" TargetType="Button">
      <Setter Property="Background" Value="#12FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="hov" CornerRadius="14" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.012" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.012" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.07"/><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.972" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.972" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.2"/><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.012" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.012" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PillBtn" TargetType="Button" BasedOn="{StaticResource IcoBtn}">
      <Setter Property="Background" Value="#22FFFFFF"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="ClipCard" TargetType="Button">
      <Setter Property="Background" Value="#12FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="12,8" Margin="0,0,0,5">
                <TextBlock Text="{TemplateBinding Content}" FontSize="12" Foreground="#E0FFFFFF" TextTrimming="CharacterEllipsis"/>
              </Border>
              <Border x:Name="hov" CornerRadius="12" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False" Margin="0,0,0,5"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.11" Duration="0:0:0.16"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.012" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.012" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.07"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.985" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.985" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.11" Duration="0:0:0.2"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.012" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.012" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DotBtn" TargetType="Button">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="0,0,9,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Border x:Name="sel" CornerRadius="15" BorderBrush="#F2FFFFFF" BorderThickness="1.6" Margin="-4" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="ring" CornerRadius="15" BorderBrush="#99FFFFFF" BorderThickness="1.2" Margin="-4" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#48FFFFFF" BorderThickness="1"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="sel">
                <Setter TargetName="sel" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.88" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.88" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="track" Width="40" Height="23" CornerRadius="12" Background="#33FFFFFF">
                <Border x:Name="knob" Width="17" Height="17" CornerRadius="9" Background="#F5FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0">
                  <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
                </Border>
              </Border>
              <Border x:Name="hov" Width="40" Height="23" CornerRadius="12" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.13" Duration="0:0:0.16"></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FF30D158" Duration="0:0:0.22"/>
                      <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="17" Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.55" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#33FFFFFF" Duration="0:0:0.26"/>
                      <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.26"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- site tile -->
    <Style x:Key="SiteTile" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
              <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Border x:Name="bg" Background="#14FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="19"/>
              <Border x:Name="hov" CornerRadius="19" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.11" Duration="0:0:0.18"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.34"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation><ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#52FFFFFF" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#1EFFFFFF" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.07"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.94" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.94" Duration="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0.11" Duration="0:0:0.2"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- text box -->
    <Style x:Key="GlassBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="SelectionBrush" Value="#770A84FF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="fbg" Background="#1EFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,8">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <ColorAnimation Storyboard.TargetName="fbg" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#A0FFFFFF" Duration="0:0:0.18"/>
                  <ColorAnimation Storyboard.TargetName="fbg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#2CFFFFFF" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <ColorAnimation Storyboard.TargetName="fbg" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#26FFFFFF" Duration="0:0:0.25"/>
                  <ColorAnimation Storyboard.TargetName="fbg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1EFFFFFF" Duration="0:0:0.25"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardTxt" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A0FFFFFF"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="SecLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#80FFFFFF"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="RowTxt" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EBFFFFFF"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="WxIco" TargetType="Path">
      <Setter Property="StrokeThickness" Value="1.7"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="Stroke" Value="#EAF2FF"/>
    </Style>
  </Window.Resources>

  <Canvas x:Name="root">

    <!-- soft shadow, cut out under the glass so it never darkens it -->
    <Canvas x:Name="ShadowWrap" Width="780" Height="640" IsHitTestVisible="False">
      <Canvas.Clip>
        <CombinedGeometry GeometryCombineMode="Exclude">
          <CombinedGeometry.Geometry1><RectangleGeometry Rect="0,0,780,640"/></CombinedGeometry.Geometry1>
          <CombinedGeometry.Geometry2><RectangleGeometry x:Name="shadowHole" Rect="332,10,116,34" RadiusX="17" RadiusY="17"/></CombinedGeometry.Geometry2>
        </CombinedGeometry>
      </Canvas.Clip>
      <Border x:Name="ShadowShape" Width="116" Height="34" Canvas.Left="332" Canvas.Top="10" CornerRadius="17" Background="#FF000000">
        <Border.Effect><DropShadowEffect x:Name="shadowFx" BlurRadius="30" ShadowDepth="9" Direction="270" Opacity="0.42"/></Border.Effect>
      </Border>
    </Canvas>

    <!-- ===================== THE ISLAND ===================== -->
    <Grid x:Name="Island" Width="116" Height="34" Canvas.Left="332" Canvas.Top="10" Cursor="Hand" Background="Transparent" AllowDrop="True">
      <Grid.Clip>
        <RectangleGeometry x:Name="islandClip" Rect="0,0,116,34" RadiusX="17" RadiusY="17"/>
      </Grid.Clip>

      <!-- glass body: blurred snapshot of what is behind the island, then the tint -->
      <Canvas x:Name="BdCanvas" IsHitTestVisible="False" Opacity="0">
        <Image x:Name="bdImg" Width="660" Height="520" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear">
          <Image.RenderTransform><TranslateTransform X="0"/></Image.RenderTransform>
        </Image>
      </Canvas>
      <Border x:Name="TintLayer" Background="#B0101014"/>
      <!-- colour wash: two soft glows (top-left and bottom-right) so the whole panel carries the colour -->
      <Grid x:Name="WashLayer" Opacity="0" IsHitTestVisible="False">
        <Border>
          <Border.Background>
            <RadialGradientBrush Center="0.1,0.06" GradientOrigin="0.1,0.06" RadiusX="1.05" RadiusY="1.15">
              <GradientStop x:Name="washC0" Color="#70FFFFFF" Offset="0"/>
              <GradientStop x:Name="washC1" Color="#00FFFFFF" Offset="1"/>
            </RadialGradientBrush>
          </Border.Background>
        </Border>
        <Border>
          <Border.Background>
            <RadialGradientBrush Center="0.92,1.0" GradientOrigin="0.92,1.0" RadiusX="1.0" RadiusY="1.0">
              <GradientStop x:Name="washD0" Color="#60FFFFFF" Offset="0"/>
              <GradientStop x:Name="washD1" Color="#00FFFFFF" Offset="1"/>
            </RadialGradientBrush>
          </Border.Background>
        </Border>
      </Grid>

      <!-- ================= COMPACT ================= -->
      <Grid x:Name="CompactLayer" Visibility="Visible">

        <Grid x:Name="cIdle" Width="150" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
          <TextBlock x:Name="cIdleTxt" Text="" Foreground="#E6FFFFFF" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
        </Grid>

        <Grid x:Name="cMusic" Width="248" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="22" Height="22" CornerRadius="7" Margin="7,0,0,0" VerticalAlignment="Center" Background="#22FFFFFF">
            <Grid>
              <TextBlock Text="♪" FontSize="11" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border CornerRadius="7"><Border.Background><ImageBrush x:Name="artS" Stretch="UniformToFill"/></Border.Background></Border>
            </Grid>
          </Border>
          <TextBlock x:Name="cMusicTxt" Grid.Column="1" Text="" Foreground="White" FontSize="11.5" FontWeight="SemiBold" Margin="9,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <StackPanel x:Name="pausePanel" Grid.Column="2" Orientation="Horizontal" Margin="0,0,11,0" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
            <Rectangle Width="3" Height="11" RadiusX="1.2" RadiusY="1.2" Fill="#E6FFFFFF" Margin="0,0,3,0"/>
            <Rectangle Width="3" Height="11" RadiusX="1.2" RadiusY="1.2" Fill="#E6FFFFFF"/>
          </StackPanel>
          <StackPanel x:Name="wavePanel" Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
            <Rectangle x:Name="w1" Width="2.6" Height="9"  RadiusX="1.3" RadiusY="1.3" Fill="#F2F2F2" Margin="0,0,2.4,0"/>
            <Rectangle x:Name="w2" Width="2.6" Height="14" RadiusX="1.3" RadiusY="1.3" Fill="#F2F2F2" Margin="0,0,2.4,0"/>
            <Rectangle x:Name="w3" Width="2.6" Height="6"  RadiusX="1.3" RadiusY="1.3" Fill="#F2F2F2" Margin="0,0,2.4,0"/>
            <Rectangle x:Name="w4" Width="2.6" Height="12" RadiusX="1.3" RadiusY="1.3" Fill="#F2F2F2" Margin="0,0,2.4,0"/>
            <Rectangle x:Name="w5" Width="2.6" Height="8"  RadiusX="1.3" RadiusY="1.3" Fill="#F2F2F2"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="cTimer" Width="176" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0">
              <Ellipse Canvas.Left="1" Canvas.Top="2" Width="14" Height="14" Stroke="#FF9F0A" StrokeThickness="1.8"/>
              <Path Data="M8 5.5 V9 L10.5 10.5" Stroke="#FF9F0A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M5.5 1 h5" Stroke="#FF9F0A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
            <TextBlock x:Name="cTimerTxt" Text="5:00" Foreground="White" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="cCharge" Width="150" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path x:Name="cChargeIco" Data="M9 0 L2.5 9 h4 L6 16 L13.5 6 H9.5 Z" Fill="#30D158" Width="12" Margin="0,0,7,0" Stretch="Uniform" VerticalAlignment="Center"/>
            <TextBlock x:Name="cChargeTxt" Text="84%" Foreground="White" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="cDone" Width="210" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Data="M2 8 l4.5 4.5 L14.5 3" Stroke="#30D158" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock x:Name="cDoneTxt" Text="Готово" Foreground="White" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="cEvent" Width="260" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox Width="15" Height="15" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9 M13.73 21a2 2 0 0 1-3.46 0" Stroke="#FF9F0A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
            <TextBlock x:Name="cEventTxt" Text="" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="216" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="cVol" Width="220" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Hidden" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox Width="16" Height="16" Margin="0,0,9,0">
              <Canvas Width="24" Height="24">
                <Path Data="M11 5 6.5 9H3v6h3.5L11 19z" Fill="White"/>
                <Path x:Name="cVolWave" Data="M15.5 8.5a5 5 0 0 1 0 7 M18.5 5.5a9 9 0 0 1 0 13" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="cVolMute" Data="M15 9.5l5 5 M20 9.5l-5 5" Stroke="#FF453A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
              </Canvas>
            </Viewbox>
            <Grid Width="130" Height="5" VerticalAlignment="Center">
              <Border Background="#33FFFFFF" CornerRadius="2.5"/>
              <Border x:Name="cVolFill" Background="#F5FFFFFF" CornerRadius="2.5" HorizontalAlignment="Left" Width="0"/>
            </Grid>
          </StackPanel>
        </Grid>

      </Grid>

      <!-- ================= EXPANDED PANEL ================= -->
      <Grid x:Name="ExpandedLayer" Width="660" Height="520" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Hidden" Opacity="0">
        <Grid.RenderTransform><TranslateTransform x:Name="expT" Y="0"/></Grid.RenderTransform>

        <Grid x:Name="tabBar" Margin="0,15,0,0" VerticalAlignment="Top" HorizontalAlignment="Center">
          <Border x:Name="tabInd" Background="#F2F2F2" CornerRadius="14" HorizontalAlignment="Left" Width="60" Opacity="0">
            <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
          </Border>
          <StackPanel x:Name="tabRow" Orientation="Horizontal">
            <Button x:Name="tbMusic" Style="{StaticResource TabBtn}" Content="Музыка"/>
            <Button x:Name="tbTodo" Style="{StaticResource TabBtn}" Content="Дела"/>
            <Button x:Name="tbWeather" Style="{StaticResource TabBtn}" Content="Погода"/>
            <Button x:Name="tbSys" Style="{StaticResource TabBtn}" Content="Система"/>
            <Button x:Name="tbSound" Style="{StaticResource TabBtn}" Content="Звук"/>
            <Button x:Name="tbClip" Style="{StaticResource TabBtn}" Content="Буфер"/>
            <Button x:Name="tbSites" Style="{StaticResource TabBtn}" Content="Сайты"/>
            <Button x:Name="tbShelf" Style="{StaticResource TabBtn}" Content="Полка"/>
            <Button x:Name="tbView" Style="{StaticResource TabBtn}" Content="Вид"/>
            <Button x:Name="tbMore" Style="{StaticResource TabBtn}" Content="Ещё"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="mMusic" Visibility="Visible" Margin="26,62,26,22" RenderTransformOrigin="0.5,0">
          <Grid.RenderTransform><TranslateTransform Y="0"/></Grid.RenderTransform>

          <Grid.ColumnDefinitions><ColumnDefinition Width="286"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel x:Name="mPlayer" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="286" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform><TransformGroup><ScaleTransform ScaleX="1" ScaleY="1"/><TranslateTransform X="0"/></TransformGroup></StackPanel.RenderTransform>
            <Border Width="176" Height="176" CornerRadius="28" HorizontalAlignment="Center" Background="#22FFFFFF">
              <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="7" Direction="270" Opacity="0.45"/></Border.Effect>
              <Grid>
                <TextBlock Text="♪" FontSize="54" Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border CornerRadius="28" BorderBrush="#33FFFFFF" BorderThickness="1"><Border.Background><ImageBrush x:Name="artB" Stretch="UniformToFill"/></Border.Background></Border>
              </Grid>
            </Border>
            <TextBlock x:Name="mTitle" Text="" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" TextTrimming="CharacterEllipsis" MaxWidth="286"/>
            <TextBlock x:Name="mArtist" Text="" Foreground="#A8FFFFFF" FontSize="12.5" HorizontalAlignment="Center" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="286"/>
            <Grid Margin="0,6,0,0" HorizontalAlignment="Center">
              <Grid x:Name="progHit" Width="286" Height="28" Background="Transparent" Cursor="Hand" >
                <Border x:Name="progTrack" Height="6" CornerRadius="5" Background="#33FFFFFF" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Border x:Name="progFill" Height="6" CornerRadius="5" Background="#F2F2F2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" IsHitTestVisible="False"/>
                <Ellipse x:Name="progKnob" Width="14" Height="14" Fill="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                  <Ellipse.RenderTransform><TransformGroup><ScaleTransform ScaleX="0.5" ScaleY="0.5"/><TranslateTransform X="0"/></TransformGroup></Ellipse.RenderTransform>
                  <Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.4"/></Ellipse.Effect>
                </Ellipse>
                <Border x:Name="progTip" Opacity="0" IsHitTestVisible="False" Background="#EE1C1C22" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="9" Width="50" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-27,0,0">
                  <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
                  <TextBlock x:Name="progTipTxt" Text="0:00" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
